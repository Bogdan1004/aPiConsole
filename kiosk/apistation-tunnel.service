[Unit]
Description=aPiStation public demo link (Cloudflare quick tunnel; visitors get the read-only Guest)
After=network-online.target apistation-hub.service

[Service]
# A fresh log each start, so the newest https://….trycloudflare.com address is easy to find.
ExecStartPre=/bin/sh -c ': > %h/.local/share/apistation/tunnel.log'
ExecStart=%h/.local/bin/cloudflared tunnel --no-autoupdate --url http://localhost:8420
StandardOutput=append:%h/.local/share/apistation/tunnel.log
StandardError=append:%h/.local/share/apistation/tunnel.log
Restart=on-failure
RestartSec=10
