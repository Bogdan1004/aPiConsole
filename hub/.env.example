# aPiStation Hub configuration. Copy to hub/.env and fill in what you have.
# Everything is optional: without a value the hub uses demo data.

# Role of this Pi: all (single Pi) | server (cloud Pi) | console (TV Pi)
APISTATION_ROLE=all
APISTATION_PORT=8420

# Claude: unlocks real recommendations and the assistant (otherwise "offline oracle")
ANTHROPIC_API_KEY=
# APISTATION_CLAUDE_MODEL=claude-opus-5-5

# Free assistant (chat): a small model on the Pi, installed by scripts/install-local-llm.sh. Costs no tokens.
# APISTATION_LLM_URL=http://127.0.0.1:8421

# Folders
# APISTATION_STORAGE=/mnt/ssd          # Cloud Drive root (default: home folder)
# APISTATION_MEDIA=/mnt/ssd/Videos     # movie files for VLC (e.g. big_buck_bunny.mp4)
# APISTATION_ROMS=/mnt/ssd/roms        # roms/<platform>/<game>, e.g. roms/nes/alterego.nes

# Music: full songs through YouTube's official embedded player (free key from Google Cloud,
# "YouTube Data API v3"; ~100 new songs a day). Without it, songs play as 30-second Deezer previews.
YOUTUBE_API_KEY=

# Jellyfin (movies)
JELLYFIN_URL=
JELLYFIN_API_KEY=

# Navidrome (music)
NAVIDROME_URL=
NAVIDROME_USER=
NAVIDROME_PASSWORD=

# Home Assistant (smart home) — long-lived access token from your HA profile page
HOMEASSISTANT_URL=
HOMEASSISTANT_TOKEN=
